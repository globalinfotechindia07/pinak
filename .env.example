# Pinak Portal Frontend Environment Variables
# Backend Base API URL (defaults to /api/v1 via Vite proxy to localhost:8080)
VITE_API_BASE_URL=/api/v1

# Target Spring Boot Core Backend host for local development proxy
VITE_BACKEND_URL=http://localhost:8080

# Map Tiles / OpenStreetMap / Google Maps Key
VITE_MAP_TILES_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
