# ==============================================================
# SUPER-APP — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values to Git.
# ==============================================================

# ---- Database ------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/superappdb
DB_USERNAME=
DB_PASSWORD=

# ---- JWT Security --------------------------------------------
JWT_SECRET=
JWT_ISSUER=superapp-api
JWT_AUDIENCE=superapp-client
# Access token expiry in milliseconds (default: 15 minutes)
JWT_ACCESS_EXPIRATION=900000
# Refresh token expiry in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# ---- CORS ----------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://admin.superapp.com

# ---- Mail (SMTP) ---------------------------------------------
# Set MAIL_MOCK=true for local dev (prints OTPs to log, no email sent)
MAIL_MOCK=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@superapp.com

# ---- App -----------------------------------------------------
APP_NAME=SuperApp
APP_BASE_URL=http://localhost:8080
