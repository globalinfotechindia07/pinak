      "name": "1. Send Mobile OTP (Screen 05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.data) {",
              "    if (jsonData.data.sessionId) {",
              "        pm.collectionVariables.set('sessionId', jsonData.data.sessionId);",
              "        console.log('✅ Auto-saved sessionId: ' + jsonData.data.sessionId);",
              "    }",
              "    if (jsonData.data.phone) {",
              "        pm.collectionVariables.set('testPhone', jsonData.data.phone);",
              "    }",
              "    console.log('ℹ️ Check PostgreSQL table mobile_otps for the 6-digit OTP code.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
