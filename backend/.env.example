# ==============================================================
# Environment Configuration Template (.env.example)
# Duplicate this file to .env for local testing or configure
# these environment variables in your Render Dashboard.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ==============================================================

# ---- Server Configuration ------------------------------------
# Port assigned automatically by Render or host environment
PORT=8080
SERVER_ADDRESS=0.0.0.0

# ---- PostgreSQL Database -------------------------------------
# Full JDBC URL (e.g. jdbc:postgresql://<host>:<port>/<dbname>)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---- Redis Cache & State -------------------------------------
# Individual parameters or complete connection URL
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=2000ms
# Optional: REDIS_URL takes precedence if specified (e.g. redis://default:pass@host:port)
REDIS_URL=

# ---- JWT Authentication --------------------------------------
# Min 256-bit secret key in hex or base64 (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_ISSUER=superapp-api
JWT_AUDIENCE=superapp-client
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes)
CORS_ALLOWED_ORIGINS=

# ---- Email (SMTP) --------------------------------------------
# Set MAIL_MOCK=true for development/testing (prints OTPs to logs)
MAIL_MOCK=true
MAIL_FROM=noreply@superapp.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Logging & Diagnostics -----------------------------------
# Recommended: INFO for production, DEBUG only for local troubleshooting
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING=INFO
