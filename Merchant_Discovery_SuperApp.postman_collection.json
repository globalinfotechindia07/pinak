        {
          "name": "Forgot Password (Request OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.message) {",
                  "    var match = jsonData.message.match(/Mock OTP: (\\d+)/);",
                  "    if (match) {",
                  "        pm.collectionVariables.set('mockResetOtp', match[1]);",
                  "        console.log('Captured Reset Mock OTP:', match[1]);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"customer@superapp.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Requests password reset OTP. In dev/mock mode, OTP is logged and printed in response message."
          }
        },
