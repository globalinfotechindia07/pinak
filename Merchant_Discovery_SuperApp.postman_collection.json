    {
      "name": "3. Transaction Platform - Payment Module",
      "item": [
        {
          "name": "Initiate Payment Intent (UPI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    pm.collectionVariables.set('paymentId', jsonData.data.id);",
                  "    pm.collectionVariables.set('paymentRef', jsonData.data.paymentReference);",
                  "    console.log('Payment Reference saved:', jsonData.data.paymentReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 499.00,\n  \"currency\": \"INR\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"storeId\": \"c3d4e5f6-a7b8-9012-cdef-123456789012\",\n  \"paymentMethod\": \"UPI\",\n  \"notes\": \"Bill payment with 20% discount offer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "initiate"]
            },
            "description": "Initiates payment intent, sets status PENDING, and returns UPI deep-link URL."
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Get Payment by Reference",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/reference/{{paymentRef}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "reference", "{{paymentRef}}"]
            }
          }
        },
        {
          "name": "Payment Gateway Webhook (Simulate SUCCESS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"{{paymentRef}}\",\n  \"gatewayTransactionId\": \"UPI_TXN_888999\",\n  \"status\": \"SUCCESS\",\n  \"amount\": 499.00,\n  \"signature\": \"mock_valid_signature\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "webhook"]
            },
            "description": "Simulates payment gateway webhook callback. On SUCCESS, updates payment, writes to Transaction History, and awards Cashback Reward Points."
          }
        },
        {
          "name": "Process Payment Refund",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 499.00,\n  \"reason\": \"Merchant cancelled order due to item stockout\"\n}"
