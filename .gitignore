# ==========================================
# Pinak Monorepo Root .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
jspm_packages/

# Build outputs
dist/
**/dist/
build/
**/build/
target/
**/target/
*.dist

# Secrets & Environment variables
.env
.env.*
!.env.example
application-local.properties
application-local.yml
secrets/
credentials/
*.pem
*.key
*.p12
*.jks
*.crt

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.settings/
.project
.classpath

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Runtime data
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Test & Coverage
coverage/
*.lcov
.nyc_output/

# TypeScript cache
*.tsbuildinfo
